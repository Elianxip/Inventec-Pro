# Desarrollo local: deja DATABASE_URL vacía y se usará SQLite (inventec.db).
#
# Producción (Render): ELIGE UNA de las dos formas. Nunca subas valores reales a GitHub.
#
# Forma A (recomendada, sin problemas de caracteres especiales): variables separadas
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
#   Session Pooler de Supabase: DB_USER = postgres.<referencia-del-proyecto>
#
# Forma B: cadena completa. El usuario DEBE ser postgres.<referencia> y la contraseña sin corchetes.
DATABASE_URL=

INVENTEC_SECRET_KEY=pon_aqui_una_clave_larga_y_aleatoria
INVENTEC_HTTPS=0
